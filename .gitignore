# Operating system / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# Editor and IDE project files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Dependency trees. The plugin has no runtime dependency on Node;
# assets/vendor/web-vitals is committed on purpose because it is a pinned runtime
# artifact produced by scripts/build-rum.mjs, but a node_modules tree never should
# be. package-lock.json is deliberately NOT ignored: CI runs `npm ci`, which
# requires the lockfile to be present and committed.
node_modules/
vendor/
pnpm-lock.yaml
yarn.lock

# Release archive output from scripts/build-release.ps1. The ZIP is uploaded as a
# GitHub release asset, not committed.
dist/

# Test and tooling caches
.phpunit.result.cache
.phpcs-cache

# Nothing below should ever be generated by the plugin itself, but keep local
# database exports and logs from being committed by accident.
*.log
*.sql
*.sql.gz
pfc-db-*.sql
wpi-db-*.sql
